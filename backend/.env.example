# Copy to backend/.env and fill in. Never commit .env.

# dev | test | prod  (prod refuses to start with insecure defaults)
JOBSCOUT_ENV=dev
JOBSCOUT_DATABASE_URL=postgresql+psycopg://jobscout:jobscout@localhost:5432/jobscout

# Random 32+ chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JOBSCOUT_SECRET_KEY=change-me
# Fernet key for encrypting uploaded files at rest (required in prod).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOBSCOUT_FILE_ENCRYPTION_KEY=

JOBSCOUT_FRONTEND_ORIGIN=http://localhost:3000
# false only for local http development; must be true in prod
JOBSCOUT_COOKIE_SECURE=false
JOBSCOUT_SESSION_TTL_HOURS=168

JOBSCOUT_UPLOAD_DIR=./var/uploads
JOBSCOUT_MAX_UPLOAD_MB=5
JOBSCOUT_RESUME_RETENTION_HOURS=24
# Optional ClamAV daemon (unix socket path or host:port). Without it, uploads are marked "not_scanned".
JOBSCOUT_CLAMD_ADDRESS=

# Employer boards searched for every user (users can add their own in Settings).
# Format: token:Display Name,token2:Other Name
JOBSCOUT_GREENHOUSE_BOARDS=
JOBSCOUT_LEVER_SITES=
